# Which Supabase project the app talks to. Vite exposes only VITE_* vars,
# and both values end up in the browser bundle, so they must be public:
# the project URL and the PUBLISHABLE key (never the secret/service key).
#
# Local dev: `npm run dev` reads .env.development (committed), which points
#   at the local stack from `npm run db:start`. Override in .env.development.local.
# Production: set both vars in Vercel (Project → Settings → Environment
#   Variables → Production) from Supabase → Project Settings → API Keys.
#   `npm run build` locally needs them too, e.g. in .env.production.local.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
